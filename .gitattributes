# 自动转换行尾符
* text=auto

# 所有文本文件使用 LF 行尾符
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.vue text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.ipynb text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
